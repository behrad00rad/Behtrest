# Copy to deploy/.env. Do not reuse backend/.env or commit credentials.
BEHTREST_DOMAIN=behtrest.example.com
FRONTEND_ORIGIN=https://behtrest.example.com
DJANGO_SECRET_KEY=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Behtrest <hello@example.com>
# Local CPU worker scans public uploads; model must be packaged before build.
BEHTREST_IMAGE_MODERATION=1
BEHTREST_IMAGE_UPLOADS_PER_DAY=100
BEHTREST_IMAGE_PENDING_PER_USER=20
BEHTREST_IMAGE_QUARANTINE_USER_MB=256
BEHTREST_IMAGE_QUARANTINE_TOTAL_MB=2048
