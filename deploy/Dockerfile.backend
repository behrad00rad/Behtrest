FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DJANGO_SETTINGS_MODULE=config.production
WORKDIR /app
COPY backend/requirements-lock.txt backend/requirements-production.txt ./
RUN pip install --no-cache-dir -r requirements-production.txt \
    && groupadd --gid 10001 behtrest \
    && useradd --uid 10001 --gid 10001 --no-create-home behtrest \
    && mkdir -p /data/media /data/private_media /static /backups \
    && chown -R behtrest:behtrest /data /static /backups
COPY backend/ ./
RUN python -c "import hashlib,pathlib; p=pathlib.Path('models/nudenet-320.onnx'); assert p.exists(), 'Run scripts/setup_image_model.py before building'; assert hashlib.sha256(p.read_bytes()).hexdigest() == 'c15d8273adad2d0a92f014cc69ab2d6c311a06777a55545f2c4eb46f51911f0f', 'Model checksum mismatch'"
USER behtrest
CMD ["uvicorn", "config.asgi:application", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log", "--no-proxy-headers"]
